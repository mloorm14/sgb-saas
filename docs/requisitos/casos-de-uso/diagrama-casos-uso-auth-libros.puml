' Generated from commit c7c6d9e (real source code)
' Use case diagrams: Auth + Book CRUD
' Actors based on real Usuario roles (Rol.nombre): LECTOR, BIBLIOTECARIO, GERENTE, ADMIN
' Permissions derived from @PreAuthorize in AuthController.java and LibroController.java

@startuml
!define RECTANGLE class

skinparam packageStyle rectangle
skinparam actorStyle awesome
skinparam usecase {
    BackgroundColor White
    BorderColor Black
    ArrowColor Black
}

package "SGB-SaaS - Authentication and Book Catalog" {

    actor "LECTOR" as lector
    actor "BIBLIOTECARIO" as biblio
    actor "GERENTE" as gerente
    actor "ADMIN" as admin

    package "Authentication (AuthController)" {
        usecase "Sign up\nPOST /api/auth/registro" as UC_Registro
        usecase "Verify email\nPOST /api/auth/verificar-correo" as UC_Verificar
        usecase "Log in\nPOST /api/auth/login" as UC_Login
        usecase "Log out\nPOST /api/auth/logout" as UC_Logout
        usecase "Refresh token\nPOST /api/auth/refresh" as UC_Refresh
    }

    package "Book Catalog (LibroController)" {
        usecase "List books\nGET /api/v1/libros" as UC_Listar
        usecase "Find book by ID\nGET /api/v1/libros/{id}" as UC_Buscar
        usecase "Autocomplete suggestions\nGET /api/v1/libros/sugerencias" as UC_Sugerir
        usecase "Create book\nPOST /api/v1/libros" as UC_Crear
        usecase "Update book\nPUT /api/v1/libros/{id}" as UC_Actualizar
        usecase "Delete book (soft delete)\nDELETE /api/v1/libros/{id}" as UC_Eliminar
    }
}

' --- Authentication: all roles can sign up/verify/log in ---
lector --> UC_Registro
biblio --> UC_Registro
gerente --> UC_Registro
admin --> UC_Registro

lector --> UC_Verificar
biblio --> UC_Verificar
gerente --> UC_Verificar
admin --> UC_Verificar

lector --> UC_Login
biblio --> UC_Login
gerente --> UC_Login
admin --> UC_Login

lector --> UC_Logout
biblio --> UC_Logout
gerente --> UC_Logout
admin --> UC_Logout

lector --> UC_Refresh
biblio --> UC_Refresh
gerente --> UC_Refresh
admin --> UC_Refresh

' --- Catalog: list/search - LECTOR, BIBLIOTECARIO, GERENTE, ADMIN ---
lector --> UC_Listar
biblio --> UC_Listar
gerente --> UC_Listar
admin --> UC_Listar

lector --> UC_Buscar
biblio --> UC_Buscar
gerente --> UC_Buscar
admin --> UC_Buscar

' --- Autocomplete: any authenticated user (isAuthenticated) ---
lector --> UC_Sugerir
biblio --> UC_Sugerir
gerente --> UC_Sugerir
admin --> UC_Sugerir

' --- Write (CRUD): only BIBLIOTECARIO, GERENTE, ADMIN ---
biblio --> UC_Crear
gerente --> UC_Crear
admin --> UC_Crear

biblio --> UC_Actualizar
gerente --> UC_Actualizar
admin --> UC_Actualizar

biblio --> UC_Eliminar
gerente --> UC_Eliminar
admin --> UC_Eliminar

' Traceability notes
note right of UC_Registro : Public (no @PreAuthorize)\nAuthController:37
note right of UC_Verificar : Public (no @PreAuthorize)\nAuthController:47
note right of UC_Login : Public\nAuthController:54
note right of UC_Logout : Requires Authorization header\nAuthController:63
note right of UC_Refresh : Requires refreshToken cookie\nAuthController:91

note right of UC_Listar : @PreAuthorize hasAnyRole\nLECTOR,BIBLIOTECARIO,GERENTE,ADMIN\nLibroController:36
note right of UC_Buscar : @PreAuthorize hasAnyRole\nLECTOR,BIBLIOTECARIO,GERENTE,ADMIN\nLibroController:63
note right of UC_Sugerir : @PreAuthorize isAuthenticated()\nLibroController:55
note right of UC_Crear : @PreAuthorize hasAnyRole\nBIBLIOTECARIO,GERENTE,ADMIN\nLibroController:70
note right of UC_Actualizar : @PreAuthorize hasAnyRole\nBIBLIOTECARIO,GERENTE,ADMIN\nLibroController:79
note right of UC_Eliminar : @PreAuthorize hasAnyRole\nBIBLIOTECARIO,GERENTE,ADMIN\nLibroController:88

@enduml