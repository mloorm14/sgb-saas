' --- Relaciones reales del código ---

' Controladores -> Servicios
AuthController --> AuthService : uses
AuthController --> JwtService : uses
LibroController --> LibroService : uses

' Servicios -> Repositorios
AuthService --> UsuarioRepository : injects
AuthService --> RolRepository : injects
AuthService --> EstadoUsuarioRepository : injects
AuthService --> BitacoraAuditoriaRepository : injects
AuthService --> VerificacionCorreoService : injects
AuthService --> JwtService : injects
AuthService --> AuthenticationManager : injects
AuthService --> LoginRateLimiter : injects
AuthService --> RedisTemplate : injects
AuthService --> PasswordEncoder : injects

LibroService --> LibroRepository : injects
LibroService --> EditorialRepository : injects
LibroService --> IdiomaRepository : injects
LibroService --> EstadoLibroRepository : injects
LibroService --> CategoriaRepository : injects
LibroService --> AutorRepository : injects

VerificacionCorreoService --> RedisTemplate : injects

' Servicios -> Entidades (operan sobre)
AuthService ..> Usuario : creates/updates/queries
AuthService ..> Rol : queries (ROL_POR_DEFECTO)
AuthService ..> EstadoUsuario : queries (PENDIENTE_VERIFICACION, ACTIVO)
AuthService ..> BitacoraAuditoria : creates

LibroService ..> Libro : creates/updates/queries/deletes (soft delete)
LibroService ..> Editorial : queries (getReferenceById)
LibroService ..> Idioma : queries (getReferenceById)
LibroService ..> EstadoLibro : queries (ACTIVO, DADO_DE_BAJA)
LibroService ..> Categoria : queries (getReferenceById)
LibroService ..> Autor : queries (getReferenceById)

' Seguridad
JwtAuthFilter --> JwtService : uses
JwtAuthFilter --> UserDetailsServiceImpl : uses
JwtAuthFilter --> RedisTemplate : uses (blacklist)

JwtService --> Usuario : uses (extraer claims)

LoginRateLimiter --> RedisTemplate : uses

UserDetailsServiceImpl --> UsuarioRepository : injects

' Entidades -> Repositorios
UsuarioRepository --> Usuario
LibroRepository --> Libro
RolRepository --> Rol
EstadoUsuarioRepository --> EstadoUsuario
EditorialRepository --> Editorial
IdiomaRepository --> Idioma
EstadoLibroRepository --> EstadoLibro
CategoriaRepository --> Categoria
AutorRepository --> Autor
BitacoraAuditoriaRepository --> BitacoraAuditoria

' Relaciones de entidad (JPA)
Usuario "*" -- "1" EstadoUsuario : estado (EAGER)
Usuario "*" -- "*" Rol : roles (EAGER, via usuario_roles)

Libro "*" -- "1" Editorial : editorial (LAZY)
Libro "*" -- "1" Idioma : idioma (LAZY)
Libro "*" -- "1" EstadoLibro : estado (LAZY)
Libro "*" -- "*" Categoria : categorias (LAZY, via libro_categorias)
Libro "*" -- "*" Autor : autores (LAZY, via libro_autores)

@enduml