@startuml
!define RECTANGLE class

skinparam classAttributeIconSize 0
skinparam linetype ortho

package "com.uteq.backend.entity" {
    class Usuario {
        +Long id
        +String nombre
        +String apellido
        +String correo
        +String passwordHash
        +String identificacionUsuario
        +UUID credencialQrToken
        +EstadoUsuario estado
        +boolean correoVerificado
        +Instant fechaRegistro
        +Instant actualizadoEn
        +Set<Rol> roles
        --
        {static} ROL_POR_DEFECTO = "LECTOR"
    }

    class Libro {
        +Long id
        +String isbn
        +String titulo
        +String resumen
        +String portadaUrl
        +Short anioPublicacion
        +Editorial editorial
        +Idioma idioma
        +EstadoLibro estado
        +Short stockTotal
        +Short stockDisponible
        +String ubicacionFisica
        +OffsetDateTime fechaRegistro
        +OffsetDateTime actualizadoEn
        +Set<Categoria> categorias
        +Set<Autor> autores
        --
        {static} ESTADO_ACTIVO = "ACTIVO"
        {static} ESTADO_DADO_DE_BAJA = "DADO_DE_BAJA"
        --
        +antesDeGuardar() : void @PrePersist
        +antesDeCualquierUpdate() : void @PreUpdate
    }

    class Rol {
        +Integer id
        +String nombre
        --
        {static} ROLES = {LECTOR, BIBLIOTECARIO, GERENTE, ADMIN}
    }

    class EstadoUsuario {
        +Long id
        +String nombre
    }

    class Editorial {
        +Long id
        +String nombre
    }

    class Idioma {
        +Long id
        +String nombre
    }

    class EstadoLibro {
        +Long id
        +String nombre
    }

    class Categoria {
        +Long id
        +String nombre
    }

    class Autor {
        +Long id
        +String nombre
    }

    class BitacoraAuditoria {
        +Long id
        +Long usuarioId
        +String tipoOperacion
        +String tablaAfectada
        +Long registroId
        +String detalles
        +String ipOrigen
        +OffsetDateTime fechaHora
    }
}

