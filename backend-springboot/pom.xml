<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<parent>
		<groupId>org.springframework.boot</groupId>
		<artifactId>spring-boot-starter-parent</artifactId>
		<version>4.0.6</version>
		<relativePath/> <!-- lookup parent from repository -->
	</parent>
	<groupId>com.uteq</groupId>
	<artifactId>backend</artifactId>
	<version>0.0.1-SNAPSHOT</version>
	<name/>
	<description/>
	<url/>
	<licenses>
		<license/>
	</licenses>
	<developers>
		<developer/>
	</developers>
	<scm>
		<connection/>
		<developerConnection/>
		<tag/>
		<url/>
	</scm>
	<properties>
		<java.version>21</java.version>
	</properties>
	<dependencies>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-data-jpa</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-data-redis</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-flyway</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-security</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-validation</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-webmvc</artifactId>
		</dependency>
		<!-- Envío de correo (Módulo 2: alertas de vencimiento/multa/reserva
		     caducada; Módulo 9.5: código de verificación al registrarse).
		     Ver EmailService - envuelve JavaMailSender y nunca propaga
		     MailException como 500. -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-mail</artifactId>
		</dependency>
		<dependency>
			<groupId>org.flywaydb</groupId>
			<artifactId>flyway-database-postgresql</artifactId>
		</dependency>

		<dependency>
			<groupId>org.postgresql</groupId>
			<artifactId>postgresql</artifactId>
			<scope>runtime</scope>
		</dependency>
		<dependency>
			<groupId>org.projectlombok</groupId>
			<artifactId>lombok</artifactId>
			<optional>true</optional>
		</dependency>

		<!-- Actuator -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-actuator</artifactId>
		</dependency>

		<!-- JWT -->
		<dependency>
			<groupId>io.jsonwebtoken</groupId>
			<artifactId>jjwt-api</artifactId>
			<version>0.12.6</version>
		</dependency>
		<dependency>
			<groupId>io.jsonwebtoken</groupId>
			<artifactId>jjwt-impl</artifactId>
			<version>0.12.6</version>
			<scope>runtime</scope>
		</dependency>
		<dependency>
			<groupId>io.jsonwebtoken</groupId>
			<artifactId>jjwt-jackson</artifactId>
			<version>0.12.6</version>
			<scope>runtime</scope>
		</dependency>

		<!-- Swagger UI / OpenAPI -->
		<dependency>
			<groupId>org.springdoc</groupId>
			<artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
			<version>3.0.3</version>
		</dependency>

		<!-- Generacion de codigos QR (credencial de usuario para identificacion
		     rapida en ventanilla). "core" trae el encoder (QRCodeWriter);
		     "javase" trae MatrixToImageWriter para convertir la matriz de bits
		     resultante a PNG sin escribir ese conversor a mano. -->
		<dependency>
			<groupId>com.google.zxing</groupId>
			<artifactId>core</artifactId>
			<version>3.5.3</version>
		</dependency>
		<dependency>
			<groupId>com.google.zxing</groupId>
			<artifactId>javase</artifactId>
			<version>3.5.3</version>
		</dependency>

		<!-- Exportación a PDF de reportes gerenciales (Módulo 7.2:
		     ReportePdfService, GET /prestamos/reportes/morosidad/pdf).
		     "itext-core" es un POM agregador que trae kernel+layout+io, etc.
		     NOTA DE LICENCIA: itext-core es AGPL v3 (no Apache/MIT) - válido
		     para este proyecto académico, pero si el sistema se distribuye
		     comercialmente hay que revisar la licencia comercial de iText o
		     cambiar a una alternativa Apache-2.0 (ej. OpenPDF). Documentar
		     esa decisión en un ADR si se llega a ese punto. -->
		<dependency>
			<groupId>com.itextpdf</groupId>
			<artifactId>itext-core</artifactId>
			<version>9.5.0</version>
			<type>pom</type>
		</dependency>

		<!-- Solo para verificar en tests que el PDF generado por
		     ReportePdfService no está vacío y contiene el texto esperado
		     (PDFTextStripper) - nunca se usa en código de producción. -->
		<dependency>
			<groupId>org.apache.pdfbox</groupId>
			<artifactId>pdfbox</artifactId>
			<version>3.0.8</version>
			<scope>test</scope>
		</dependency>

		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-test</artifactId>
			<scope>test</scope>
		</dependency>
		<!-- H2 en memoria: reemplaza PostgreSQL en tests para que todos los
		     JpaRepository se creen automaticamente sin necesidad de mockear
		     cada repositorio en BackendApplicationTests. -->
		<dependency>
			<groupId>com.h2database</groupId>
			<artifactId>h2</artifactId>
			<scope>test</scope>
		</dependency>
		<!-- @WithMockUser / SecurityMockMvcRequestPostProcessors: necesario
		     para testear @PreAuthorize a nivel de controller sin tener que
		     generar un JWT real (ver LibroControllerSecurityTest). Version
		     gestionada por spring-boot-starter-parent. -->
		<dependency>
			<groupId>org.springframework.security</groupId>
			<artifactId>spring-security-test</artifactId>
			<scope>test</scope>
		</dependency>
		<!-- @WebMvcTest: en Spring Boot 4 se movio a su propio modulo
		     (org.springframework.boot.webmvc.test.autoconfigure), ya no
		     viene incluido en spring-boot-test-autoconfigure. -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-webmvc-test</artifactId>
			<scope>test</scope>
		</dependency>
	</dependencies>

	<build>
		<plugins>
			<plugin>
				<groupId>org.springframework.boot</groupId>
				<artifactId>spring-boot-maven-plugin</artifactId>
				<configuration>
					<excludes>
						<exclude>
							<groupId>org.projectlombok</groupId>
							<artifactId>lombok</artifactId>
						</exclude>
					</excludes>
				</configuration>
			</plugin>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-compiler-plugin</artifactId>
				<executions>
					<execution>
						<id>default-compile</id>
						<phase>compile</phase>
						<goals>
							<goal>compile</goal>
						</goals>
						<configuration>
							<annotationProcessorPaths>
								<path>
									<groupId>org.projectlombok</groupId>
									<artifactId>lombok</artifactId>
								</path>
							</annotationProcessorPaths>
						</configuration>
					</execution>
					<execution>
						<id>default-testCompile</id>
						<phase>test-compile</phase>
						<goals>
							<goal>testCompile</goal>
						</goals>
						<configuration>
							<annotationProcessorPaths>
								<path>
									<groupId>org.projectlombok</groupId>
									<artifactId>lombok</artifactId>
								</path>
							</annotationProcessorPaths>
						</configuration>
					</execution>
				</executions>
			</plugin>
			<!-- Bloque C.4: cobertura de dominio/servicios. Se excluyen del
			     analisis las clases que no aportan valor real medido con
			     cobertura de linea/rama:
			     - dto/**: records planos sin logica (solo transporte de datos).
			     - entity/**: entidades JPA con @Data (getters/setters generados
			       por Lombok), sin metodos de negocio propios.
			     - config/**: clases @Configuration que solo definen beans
			       (wiring de framework), no logica de negocio testeable de forma
			       aislada; probarlas de verdad requeriria un contexto Spring
			       completo, que ya cubren los tests de arranque/integracion.
			     - BackendApplication: punto de entrada (main), sin logica. -->
			<plugin>
				<groupId>org.jacoco</groupId>
				<artifactId>jacoco-maven-plugin</artifactId>
				<version>0.8.12</version>
				<configuration>
					<excludes>
						<exclude>com/uteq/backend/dto/**</exclude>
						<exclude>com/uteq/backend/entity/**</exclude>
						<exclude>com/uteq/backend/config/**</exclude>
						<exclude>com/uteq/backend/BackendApplication.class</exclude>
					</excludes>
				</configuration>
				<executions>
					<execution>
						<id>jacoco-prepare-agent</id>
						<goals>
							<goal>prepare-agent</goal>
						</goals>
					</execution>
					<execution>
						<id>jacoco-report</id>
						<phase>verify</phase>
						<goals>
							<goal>report</goal>
						</goals>
					</execution>
				</executions>
			</plugin>

			<!-- Bloque A.2.3 / criterio P3 de la rubrica: analisis estatico de
			     seguridad, con foco en concatenacion de SQL dinamico.
			     Config resultante de fusionar dos ramas que construyeron esto
			     mismo en paralelo (main y feature/seguridad-analisis-estatico-sql):
			     ver el commit de merge para el detalle de que se tomo de
			     cada lado y por que.

			     VERSIONES: verificadas contra el metadata.xml real de Maven
			     Central el 2026-08-15 (repo1.maven.org/.../maven-metadata.xml),
			     no copiadas de memoria.
			       - findsecbugs-plugin: 1.14.0 es la ultima version publicada
			         (sin release mas nueva desde 2025-04-20).
			       - spotbugs-maven-plugin: se fija 4.8.3.1 (no 4.9.3.0 ni la
			         ultima publicada, 4.10.3.0). El propio CHANGELOG de
			         find-sec-bugs 1.14.0 declara que esa release se
			         construyo y probo contra el nucleo de SpotBugs 4.8.3; no
			         se encontro evidencia (ni en el repo de find-sec-bugs ni
			         en el de spotbugs-maven-plugin) de que 1.14.0 este
			         verificado contra las lineas 4.9.x/4.10.x mas nuevas.
			         SpotBugs 4.8.x ya soporta bytecode de Java 21 (ASM 9.6,
			         agregado en la release 4.8.0), asi que no hay perdida de
			         compatibilidad real con este backend.
			       - El plugin find-sec-bugs se declara como <dependencies>
			         del plugin (mecanismo estandar y ya verificado: corrio
			         real con BUILD SUCCESS y 0 hallazgos antes de este
			         merge), no como <configuration><plugins> (forma
			         alternativa usada en la otra rama, sin verificar en este
			         repo): ante la duda, se prefirio la que ya se probo.
			       - threshold=Low (no "high"): adoptado de la otra rama a
			         proposito. Dentro de un filtro ya acotado a solo
			         patrones de inyeccion SQL (spotbugs-security-include.xml),
			         un hallazgo de confianza baja sigue siendo señal real de
			         concatenacion hacia SQL ejecutable, y P1/P3 exigen cero
			         tolerancia en A.2.3. maxAllowedViolations=0 lo deja
			         explicito (es el default del goal `check`, pero
			         documentarlo evita que alguien lo lea como negociable).
			       - xmlOutput/htmlOutput=true se mantienen (la otra rama no
			         los tenia): el step "Archivar reporte de SpotBugs" del
			         CI (ver .github/workflows/ci.yml) depende de que
			         target/spotbugs.xml y target/spotbugs.html existan.

			     DISENO: dos goals distintos, mismo proposito dividido en dos
			     pasos. `spotbugs` genera el reporte XML+HTML completo (TODOS
			     los hallazgos, informativo, nunca rompe el build); `check`
			     usa spotbugs-security-include.xml + threshold=Low para que
			     un hallazgo en las reglas de SQL dinamico de ese filtro
			     rompa `./mvnw verify`. Hallazgos de otras categorias no
			     tocan el exit code de este build, para no bloquear CI por
			     algo fuera del alcance de esta tarea. -->
			<plugin>
				<groupId>com.github.spotbugs</groupId>
				<artifactId>spotbugs-maven-plugin</artifactId>
				<version>4.8.3.1</version>
				<dependencies>
					<!-- Dependencia DEL PLUGIN (analizador cargado por SpotBugs),
					     no del proyecto: no aparece en el classpath de
					     compilacion/runtime del backend. -->
					<dependency>
						<groupId>com.h3xstream.findsecbugs</groupId>
						<artifactId>findsecbugs-plugin</artifactId>
						<version>1.14.0</version>
					</dependency>
				</dependencies>
				<configuration>
					<effort>Max</effort>
					<threshold>Low</threshold>
					<xmlOutput>true</xmlOutput>
					<htmlOutput>true</htmlOutput>
					<includeFilterFile>${project.basedir}/spotbugs-security-include.xml</includeFilterFile>
					<failOnError>true</failOnError>
					<maxAllowedViolations>0</maxAllowedViolations>
				</configuration>
				<executions>
					<!-- NOTA DE DISENO (probado, no el diseno original): se
					     intento primero separar esto en dos ejecuciones con
					     configuracion distinta (reporte SIN filtro + check
					     CON filtro, cada uno con su propio <configuration>
					     por ejecucion) para que el reporte fuera un audit
					     completo y el check quedara acotado a las reglas de
					     SQL. No funciono: `check` invoca internamente un
					     sub-goal `spotbugs` de forma forkeada que ignora la
					     configuracion propia de la ejecucion `check` y usa
					     solo la configuracion de nivel de plugin. Con el
					     filtro solo en la ejecucion de `check`, el resultado
					     observado fue que `check` evaluaba los 38 hallazgos
					     SIN filtrar del proyecto entero (EI_EXPOSE_REP,
					     BC_VACUOUS_INSTANCEOF, etc.), no solo los patrones
					     de SQL dinamico. Confirmado corriendo `./mvnw
					     clean verify` y leyendo el log real, no asumido. Por
					     eso ambos goals comparten la MISMA configuracion de
					     arriba: el reporte de `spotbugs-report` tambien
					     queda acotado a los patrones de SQL dinamico (no es
					     un audit completo de todas las categorias). Es una
					     limitacion real de este diseno, documentada aqui en
					     vez de prometer un reporte mas amplio del que en
					     realidad se genera. -->
					<execution>
						<id>spotbugs-report</id>
						<phase>verify</phase>
						<goals>
							<goal>spotbugs</goal>
						</goals>
					</execution>
					<execution>
						<id>spotbugs-check-sql-dinamico</id>
						<phase>verify</phase>
						<goals>
							<goal>check</goal>
						</goals>
					</execution>
				</executions>
			</plugin>
		</plugins>
	</build>

</project>
