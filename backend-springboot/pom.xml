<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<parent>
		<groupId>org.springframework.boot</groupId>
		<artifactId>spring-boot-starter-parent</artifactId>
		<version>4.0.6</version>
		<relativePath/> <!-- lookup parent from repository -->
	</parent>
	<groupId>com.uteq</groupId>
	<artifactId>backend</artifactId>
	<version>0.0.1-SNAPSHOT</version>
	<name/>
	<description/>
	<url/>
	<licenses>
		<license/>
	</licenses>
	<developers>
		<developer/>
	</developers>
	<scm>
		<connection/>
		<developerConnection/>
		<tag/>
		<url/>
	</scm>
	<properties>
		<java.version>21</java.version>
	</properties>
	<dependencies>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-data-jpa</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-data-redis</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-flyway</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-security</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-validation</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-webmvc</artifactId>
		</dependency>
		<!-- Envío de correo (Módulo 2: alertas de vencimiento/multa/reserva
		     caducada; Módulo 9.5: código de verificación al registrarse).
		     Ver EmailService - envuelve JavaMailSender y nunca propaga
		     MailException como 500. -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-mail</artifactId>
		</dependency>
		<dependency>
			<groupId>org.flywaydb</groupId>
			<artifactId>flyway-database-postgresql</artifactId>
		</dependency>

		<dependency>
			<groupId>org.postgresql</groupId>
			<artifactId>postgresql</artifactId>
			<scope>runtime</scope>
		</dependency>
		<dependency>
			<groupId>org.projectlombok</groupId>
			<artifactId>lombok</artifactId>
			<optional>true</optional>
		</dependency>

		<!-- Actuator -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-actuator</artifactId>
		</dependency>

		<!-- JWT -->
		<dependency>
			<groupId>io.jsonwebtoken</groupId>
			<artifactId>jjwt-api</artifactId>
			<version>0.12.6</version>
		</dependency>
		<dependency>
			<groupId>io.jsonwebtoken</groupId>
			<artifactId>jjwt-impl</artifactId>
			<version>0.12.6</version>
			<scope>runtime</scope>
		</dependency>
		<dependency>
			<groupId>io.jsonwebtoken</groupId>
			<artifactId>jjwt-jackson</artifactId>
			<version>0.12.6</version>
			<scope>runtime</scope>
		</dependency>

		<!-- Swagger UI / OpenAPI -->
		<dependency>
			<groupId>org.springdoc</groupId>
			<artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
			<version>3.0.3</version>
		</dependency>

		<!-- Generacion de codigos QR (credencial de usuario para identificacion
		     rapida en ventanilla). "core" trae el encoder (QRCodeWriter);
		     "javase" trae MatrixToImageWriter para convertir la matriz de bits
		     resultante a PNG sin escribir ese conversor a mano. -->
		<dependency>
			<groupId>com.google.zxing</groupId>
			<artifactId>core</artifactId>
			<version>3.5.3</version>
		</dependency>
		<dependency>
			<groupId>com.google.zxing</groupId>
			<artifactId>javase</artifactId>
			<version>3.5.3</version>
		</dependency>

		<!-- Exportación a PDF de reportes gerenciales (Módulo 7.2:
		     ReportePdfService, GET /prestamos/reportes/morosidad/pdf).
		     "itext-core" es un POM agregador que trae kernel+layout+io, etc.
		     NOTA DE LICENCIA: itext-core es AGPL v3 (no Apache/MIT) - válido
		     para este proyecto académico, pero si el sistema se distribuye
		     comercialmente hay que revisar la licencia comercial de iText o
		     cambiar a una alternativa Apache-2.0 (ej. OpenPDF). Documentar
		     esa decisión en un ADR si se llega a ese punto. -->
		<dependency>
			<groupId>com.itextpdf</groupId>
			<artifactId>itext-core</artifactId>
			<version>9.5.0</version>
			<type>pom</type>
		</dependency>

		<!-- Solo para verificar en tests que el PDF generado por
		     ReportePdfService no está vacío y contiene el texto esperado
		     (PDFTextStripper) - nunca se usa en código de producción. -->
		<dependency>
			<groupId>org.apache.pdfbox</groupId>
			<artifactId>pdfbox</artifactId>
			<version>3.0.8</version>
			<scope>test</scope>
		</dependency>

		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-test</artifactId>
			<scope>test</scope>
		</dependency>
		<!-- @WithMockUser / SecurityMockMvcRequestPostProcessors: necesario
		     para testear @PreAuthorize a nivel de controller sin tener que
		     generar un JWT real (ver LibroControllerSecurityTest). Version
		     gestionada por spring-boot-starter-parent. -->
		<dependency>
			<groupId>org.springframework.security</groupId>
			<artifactId>spring-security-test</artifactId>
			<scope>test</scope>
		</dependency>
		<!-- @WebMvcTest: en Spring Boot 4 se movio a su propio modulo
		     (org.springframework.boot.webmvc.test.autoconfigure), ya no
		     viene incluido en spring-boot-test-autoconfigure. -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-webmvc-test</artifactId>
			<scope>test</scope>
		</dependency>
	</dependencies>

	<build>
		<plugins>
			<plugin>
				<groupId>org.springframework.boot</groupId>
				<artifactId>spring-boot-maven-plugin</artifactId>
				<configuration>
					<excludes>
						<exclude>
							<groupId>org.projectlombok</groupId>
							<artifactId>lombok</artifactId>
						</exclude>
					</excludes>
				</configuration>
			</plugin>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-compiler-plugin</artifactId>
				<executions>
					<execution>
						<id>default-compile</id>
						<phase>compile</phase>
						<goals>
							<goal>compile</goal>
						</goals>
						<configuration>
							<annotationProcessorPaths>
								<path>
									<groupId>org.projectlombok</groupId>
									<artifactId>lombok</artifactId>
								</path>
							</annotationProcessorPaths>
						</configuration>
					</execution>
					<execution>
						<id>default-testCompile</id>
						<phase>test-compile</phase>
						<goals>
							<goal>testCompile</goal>
						</goals>
						<configuration>
							<annotationProcessorPaths>
								<path>
									<groupId>org.projectlombok</groupId>
									<artifactId>lombok</artifactId>
								</path>
							</annotationProcessorPaths>
						</configuration>
					</execution>
				</executions>
			</plugin>
			<!-- Bloque C.4: cobertura de dominio/servicios. Se excluyen del
			     analisis las clases que no aportan valor real medido con
			     cobertura de linea/rama:
			     - dto/**: records planos sin logica (solo transporte de datos).
			     - entity/**: entidades JPA con @Data (getters/setters generados
			       por Lombok), sin metodos de negocio propios.
			     - config/**: clases @Configuration que solo definen beans
			       (wiring de framework), no logica de negocio testeable de forma
			       aislada; probarlas de verdad requeriria un contexto Spring
			       completo, que ya cubren los tests de arranque/integracion.
			     - BackendApplication: punto de entrada (main), sin logica. -->
			<plugin>
				<groupId>org.jacoco</groupId>
				<artifactId>jacoco-maven-plugin</artifactId>
				<version>0.8.12</version>
				<configuration>
					<excludes>
						<exclude>com/uteq/backend/dto/**</exclude>
						<exclude>com/uteq/backend/entity/**</exclude>
						<exclude>com/uteq/backend/config/**</exclude>
						<exclude>com/uteq/backend/BackendApplication.class</exclude>
					</excludes>
				</configuration>
				<executions>
					<execution>
						<id>jacoco-prepare-agent</id>
						<goals>
							<goal>prepare-agent</goal>
						</goals>
					</execution>
					<execution>
						<id>jacoco-report</id>
						<phase>verify</phase>
						<goals>
							<goal>report</goal>
						</goals>
					</execution>
				</executions>
			</plugin>
			<!-- Bloque A.2.3: analisis estatico de seguridad (SpotBugs +
			     find-sec-bugs) sobre SQL dinamico. spotbugs:check enlazado a
			     verify: el build falla si find-sec-bugs detecta concatenacion
			     de strings hacia una query ejecutable (SQL_INJECTION_JDBC /
			     SQL_INJECTION_JPA / SQL_INJECTION_HIBERNATE /
			     SQL_INJECTION_SPRING_JDBC / SQL_INJECTION) o si SpotBugs
			     encuentra un string no constante hacia execute()/addBatch()
			     (SQL_NONCONSTANT_STRING_PASSED_TO_EXECUTE) o hacia
			     prepareStatement() (SQL_PREPARED_STATEMENT_GENERATED_FROM_
			     NONCONSTANT_STRING). includeFilterFile restringe el analisis
			     a esas reglas y nada mas (ver spotbugs-security-include.xml):
			     un hallazgo de otra categoria no debe tumbar el build. Con
			     effort=Max y threshold=Low para minimizar falsos negativos.
			     Todo hallazgo real de estas reglas deja A.2.3 (y P1/P3 por
			     cascada) en Insuficiente, asi que check debe fallar, no solo
			     reportar. -->
			<plugin>
				<groupId>com.github.spotbugs</groupId>
				<artifactId>spotbugs-maven-plugin</artifactId>
				<version>4.9.3.0</version>
				<configuration>
					<plugins>
						<plugin>
							<groupId>com.h3xstream.findsecbugs</groupId>
							<artifactId>findsecbugs-plugin</artifactId>
							<version>1.14.0</version>
						</plugin>
					</plugins>
					<includeFilterFile>spotbugs-security-include.xml</includeFilterFile>
					<effort>Max</effort>
					<threshold>Low</threshold>
					<failOnError>true</failOnError>
					<maxAllowedViolations>0</maxAllowedViolations>
				</configuration>
				<executions>
					<execution>
						<id>spotbugs-security-check</id>
						<phase>verify</phase>
						<goals>
							<goal>check</goal>
						</goals>
					</execution>
				</executions>
			</plugin>
		</plugins>
	</build>

</project>
