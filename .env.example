# ─────────────────────────────────────────────────────────────
# SGB-SaaS — Variables de entorno
# Copiar este archivo: cp .env.example .env
# ─────────────────────────────────────────────────────────────

# JWT — clave simétrica HS256 usada por JwtService para firmar/validar
# accessToken y refreshToken. Mínimo 256 bits (32 caracteres).
# Generar una real con: openssl rand -hex 32
# NUNCA reutilizar este valor de ejemplo en un entorno real.
JWT_SECRET=dev_secret_cambiar_en_produccion_min_32_chars

# Base de datos PostgreSQL — usada por Spring Datasource/JPA/Flyway.
# Dentro de docker compose el host es el nombre del servicio (postgres);
# si se ejecuta el backend fuera de Docker, usar localhost:5432.
DB_URL=jdbc:postgresql://postgres:5432/sgb_db
DB_USER=sgb_user
DB_PASSWORD=changeme

# Redis — usado como blacklist de tokens JWT revocados (ver ADR-003).
# Dentro de docker compose el host es el nombre del servicio (redis);
# si se ejecuta el backend fuera de Docker, usar localhost.
REDIS_HOST=redis
REDIS_PORT=6379
