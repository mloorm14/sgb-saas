# ─────────────────────────────────────────────────────────────
# SGB-SaaS — Variables de entorno
# Copiar este archivo: cp .env.example .env
# ─────────────────────────────────────────────────────────────

# JWT — clave simétrica HS256 usada por JwtService para firmar/validar
# accessToken y refreshToken. Mínimo 256 bits (32 caracteres).
# Generar una real con: openssl rand -hex 32
# NUNCA reutilizar este valor de ejemplo en un entorno real.
JWT_SECRET=dev_secret_cambiar_en_produccion_min_32_chars

# Base de datos PostgreSQL — usada por Spring Datasource/JPA/Flyway.
# Dentro de docker compose el host es el nombre del servicio (postgres);
# si se ejecuta el backend fuera de Docker, usar localhost:5432.
# DB_URL para Neon (remover &channel_binding=require si da error de driver)
# Formato: postgres://usuario:password@ep-host.neon.tech/nombre_bdd?sslmode=require
# Ejemplo real (quitar channel_binding):
# DB_URL=postgres://neondb_owner:npg_towB6CP7vmIn@ep-curly-darkness-axja1uxr.c-4.us-east-2.aws.neon.tech/neondb?sslmode=require
# O con jdbc: (quitar channel_binding):
# DB_URL=jdbc:postgresql://ep-curly-darkness-axja1uxr.c-4.us-east-2.aws.neon.tech/neondb?sslmode=require
DB_USER=sgb_user
DB_PASSWORD=changeme

# Redis — usado como blacklist de tokens JWT revocados (ver ADR-003).
# Dentro de docker compose el host es el nombre del servicio (redis);
# si se ejecuta el backend fuera de Docker, usar localhost.
REDIS_HOST=redis
REDIS_PORT=6379

# TTL (segundos) del cache Redis del listado de libros (GET /api/v1/libros,
# cache "libros" en RedisConfig/LibroService). 300 = 5 minutos: suficiente
# para absorber ráfagas de tráfico del catálogo público sin servir datos
# desactualizados por mucho tiempo (además se invalida antes vía @CacheEvict
# en cada alta/edición/baja de libro). Ver docs/adr/adr-008-ttl-cache-libros.md.
CACHE_LIBROS_TTL_SECONDS=300

# TTL (segundos) del cache Redis del autocompletado de catálogo
# (búsqueda predictiva de libros, GET /api/v1/libros/sugerencias).
# Corto a propósito (5-10s) porque es autocompletado letra por letra:
# un TTL largo serviría sugerencias desactualizadas frente a altas/bajas
# recientes de libros. Sin @CacheEvict explícito, se apoya solo en este
# TTL corto para no quedar obsoleto. Ver app.cache.sugerencias en
# application.yml.
CACHE_SUGERENCIAS_TTL_SECONDS=8

# Rate limiting de login (OWASP A07, Bloque C.2) — LoginRateLimiter cuenta
# intentos fallidos en Redis por combinación correo+IP. Al alcanzar
# LOGIN_MAX_ATTEMPTS dentro de la ventana, /api/auth/login responde 429
# sin intentar autenticar, hasta que la ventana expire o el usuario acierte
# la contraseña (lo que resetea el contador). Ver
# backend-springboot/.../security/LoginRateLimiter.java.
LOGIN_RATE_LIMIT_WINDOW_SECONDS=900
LOGIN_MAX_ATTEMPTS=5

# Perfil de Spring activo (Modulo 10.2, REQ-NF-014, ver
# docs/adr/adr-015-tls-transporte.md). Vacio/sin definir = perfil
# default (Swagger UI/OpenAPI accesibles, stacktraces visibles en /error
# -- pensado para desarrollo local). Poner en "prod" SOLO para un
# despliegue real detras de un proxy TLS: deshabilita Swagger UI/OpenAPI
# y oculta stacktraces/mensajes internos. NUNCA dejar "prod" activo en
# el .env de desarrollo del equipo, rompe la posibilidad de probar
# endpoints a mano en /swagger-ui.html.
SPRING_PROFILES_ACTIVE=

# ─── Pendiente de uso: Módulo 2 (notificaciones por correo) ───────────────
# Todavía NO consumidas por application.yml (se agregan recién con
# spring-boot-starter-mail). Nunca usar credenciales
# de una cuenta personal: en producción debe ser un servicio dedicado
# (SendGrid, Amazon SES) o el SMTP institucional @uteq.edu.ec.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# ─── Módulo 4 / H (asistente virtual con Gemini) ───────────────────────────
# Conseguir una key en Google AI Studio. NUNCA commitear el valor real —
# solo por variable de entorno. En CI se usa GEMINI_API_KEY=dummy-key-para-ci
# (los tests de GeminiClient/ChatbotService se mockean, nunca pegan a la API).
GEMINI_API_KEY=

# Opcionales — application.yml ya trae defaults con : (ver sección app.gemini),
# estas variables solo sirven para sobreescribirlos sin tocar el archivo.
# Modelo a usar (gemini-2.0-flash por defecto).
# GEMINI_MODELO=gemini-2.0-flash
# Timeout (ms) de conexión/lectura del GeminiClient.
# GEMINI_TIMEOUT_MS=8000
# Rate limit del chatbot: máx. mensajes por usuario por ventana (segundos).
# CHATBOT_RATE_LIMIT_MAX_MENSAJES=10
# CHATBOT_RATE_LIMIT_WINDOW_SECONDS=60